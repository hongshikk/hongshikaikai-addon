{
  "schemaVersion": 1,
  "id": "hongshikaikai",
  "version": "${version}",
  "name": "HongShiKaiKai",
  "description": "A Meteor Client addon with ElytraFly+ and Scaffold+.",
  "authors": [
    "hongshikaikai"
  ],
  "contact": {
    "sources": "https://github.com/hongshikaikai/HongShiKaiKai"
  },
  "icon": "assets/hongshikaikai/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.hongshikaikai.addon.HongShiKaiKai"
    ]
  },
  "mixins": [
    "hongshikaikai.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
